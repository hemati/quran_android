# Copy to keystore.properties (gitignored) to sign release builds.
# Without it, debug builds work and release builds come out unsigned.

# Absolute, or relative to the project root.
storeFile=/path/to/appcoholic-laptop.keystore
# Rattil's upload key: alias quran, SHA1 10:10:07:ED:97:27:7D:2E:FD:EF:BA:48:37:B9:68:F4:1C:6E:7B:6C
keyAlias=quran

# A command that prints the password, so it never sits in a file in plain text.
# It only runs for release tasks. PKCS12 keystore: key password = store password.
passwordCommand=python3 -m keyring get appcoholic-keystore upload

# Or set the passwords directly (not recommended):
#storePassword=
#keyPassword=
